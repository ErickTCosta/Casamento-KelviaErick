# Pooler em modo transação para a aplicação.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&sslmode=require"

# Pooler em modo sessão para migrações e criação do schema.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"

ADMIN_USERNAME="Erick"
# Token aleatorio de uso unico para autorizar a criacao da senha no primeiro acesso.
ADMIN_SETUP_TOKEN="gere-um-token-aleatorio-e-remova-apos-configurar-o-administrador"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
